{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "dashboard",
        "run",
        "start",
        "--",
        "--proxy-config",
        "proxy.local.json",
        "--host",
        "127.0.0.1",
        "--port",
        "4200"
      ],
      "port": 4200
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
