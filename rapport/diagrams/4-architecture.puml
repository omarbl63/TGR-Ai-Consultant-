@startuml architecture
' Architecture technique — Agent Administratif IA (Trésorerie Générale du Royaume)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName SansSerif
skinparam dpi 150
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #222222
}
skinparam rectangle {
  BackgroundColor #F4F4F4
  BorderColor #333333
}
skinparam database {
  BackgroundColor #ECECEC
  BorderColor #555555
}
skinparam cloud {
  BackgroundColor #EAEAEA
  BorderColor #222222
}
title Architecture technique — vue d'ensemble (conteneurisee Docker)

actor "Employe" as EMP #EAEAEA
actor "Responsable /\nDirecteur / Admin" as RESP #EAEAEA

node "Application mobile\nExpo / React Native" as MOBILE
node "Tableau de bord\nAngular 19 + nginx" as DASH

package "Docker Compose  (reseau adminai-net)" {
  node "Backend  —  Spring Boot 3.4 (Java 21)" as BACK {
    rectangle "API REST\n(JWT, Spring Security)" as REST
    rectangle "Orchestrateur IA" as ORCH
    rectangle "Modules metier\n(demandes, conges,\nconversations, notifications,\nutilisateurs, audit)" as BIZ
    rectangle "Pipeline RAG\n(ingestion / recherche /\nanalyse)" as RAGM
  }
  database "PostgreSQL 16\n+ pgvector\n(donnees + embeddings)" as PG
  node "Ollama\n(embeddings bge-m3)" as OLLAMA
}

cloud "OpenRouter\nLLM Qwen3\n(API compatible OpenAI)" as LLM

EMP --> MOBILE
RESP --> DASH
MOBILE --> REST : HTTPS / JSON
DASH --> REST : HTTPS / JSON

REST --> ORCH
REST --> BIZ
ORCH --> RAGM
ORCH --> BIZ
BIZ --> PG : JPA / Flyway
RAGM --> PG : recherche vectorielle
RAGM --> OLLAMA : vectorisation (bge-m3)
ORCH --> LLM : completion (Qwen3)
RAGM --> LLM : completion (Qwen3)

@enduml
