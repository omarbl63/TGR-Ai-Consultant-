# =============================================================================
# AdminAI — Environment configuration (EXAMPLE)
# Copy this file to `.env` and fill in the secrets. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------------------
POSTGRES_DB=adminai
POSTGRES_USER=adminai
POSTGRES_PASSWORD=change_me_in_dev
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend (Spring Boot)
# -----------------------------------------------------------------------------
BACKEND_PORT=8080
DASHBOARD_PORT=4200
SPRING_PROFILES_ACTIVE=docker

# JWT — generate a strong 256-bit base64 secret, e.g.:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_BASE64_SECRET_AT_LEAST_48_BYTES
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# -----------------------------------------------------------------------------
# LLM — Qwen3 via an OpenAI-compatible cloud endpoint
# -----------------------------------------------------------------------------
# Option A — OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=qwen/qwen3-30b-a3b        (set to the exact slug you have access to)
# Option B — Alibaba DashScope (compatible mode):
#   LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen3-30b-a3b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-30b-a3b
LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# Embeddings — BAAI/bge-m3 served locally by Ollama (in Docker)
# -----------------------------------------------------------------------------
OLLAMA_PORT=11434
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# -----------------------------------------------------------------------------
# File storage (uploaded administrative documents)
# -----------------------------------------------------------------------------
FILE_STORAGE_PATH=/app/storage
MAX_FILE_SIZE_MB=25
